# docker compose run --rm job が読む設定。.env に写して使う。.env はコミットしない。
# Claude API のキー。要約と選別に使う。値はコミットせず、.env か実行環境の環境変数で渡す。
ANTHROPIC_API_KEY=
# 要約と選別に使うモデル。既定は claude-sonnet-5-5。費用を抑えるなら claude-haiku-5-5。
LLM_MODEL=claude-sonnet-5-5
# 1 回の実行で保存する記事の上限。
MAX_ARTICLES_PER_DAY=10
# 保存先は compose.yaml でいつも Firestore エミュレーターになる。本番の GCP の認証情報は置かない。
