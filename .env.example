# docker compose run --rm job が読む設定。.env に写して使う。.env はコミットしない。
# 集める発信元のフィード (RSS か Atom)。
FEED_URL=https://openai.com/news/rss.xml
# 1 回に見る、フィードの先頭からの記事の数。保存済みの記事は保存し直さない。
COLLECT_LIMIT=1
# 保存先は compose.yaml でいつも Firestore エミュレーターになる。本番の GCP の認証情報は置かない。
# LLM の API キーなどの秘密情報は #2 で加える。値はコミットせず、.env に置く。
